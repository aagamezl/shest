# Expand one path argument (file, directory or glob) to test files, one per line.
resolve_pattern() {
  local pattern="$1"
  local match
  local IFS=$'\n'

  if [[ -d $pattern ]]; then
    find "$pattern" -type f -name "$TEST_FILE_NAME_PATTERN" | sort
    return
  fi

  # "**" recursion is done with find so it behaves the same on bash 3.2 (macOS).
  if [[ $pattern == *'**'* ]]; then
    local prefix="${pattern%%\*\**}"
    prefix="${prefix%/}"
    find "${prefix:-.}" -type f \( -path "${pattern//\*\*/*}" -o -path "${pattern//\*\*\//}" \) | sort
    return
  fi

  shopt -s nullglob
  # shellcheck disable=SC2206
  for match in $pattern; do
    if [[ -f $match ]]; then
      echo "$match"
    fi
  done
}

# Run one test file in a child process. Uses coverage_file and results_file
# from run_files (bash locals are visible to the functions it calls).
run_file_child() {
  local color=''

  if [[ $PARALLEL -gt 1 && -n $C_RESET ]]; then
    color=1
  fi
  SHEST_FORCE_COLOR="$color" SHEST_TIMING="$TIMING" SHEST_TEST_TIMEOUT="$TEST_TIMEOUT" SHEST_EVENTS_FILE="$2" SHEST_COVERAGE_FILE="$coverage_file" SHEST_RESULTS_FILE="$results_file" \
    bash "$SHEST_SELF" --run-file "$1" --filter "$NAME_FILTER"
}

# Run the files with up to PARALLEL child processes at once. A new file starts
# as soon as any slot frees up. Each file's output is captured and printed in
# order, so it never interleaves. Updates the counters of run_files.
run_files_parallel() {
  local files=("$@")
  local count=$#
  local dir
  dir="$(mktemp -d)"
  local started=0 finished=0 running=0 stop=false progressed index
  # Per-file event files are only needed when a reporter is collecting events.
  local job_events="$events_file"

  while true; do
    progressed=false

    # Print finished files, in order. The status file is written last.
    while [[ $finished -lt $started && -f "${dir}/status.${finished}" ]]; do
      total_files=$((total_files + 1))
      rule "${files[$finished]}"
      cat "${dir}/out.${finished}"
      if [[ -n $events_file && -f "${dir}/events.${finished}" ]]; then
        cat "${dir}/events.${finished}" >>"$events_file"
      fi
      if [[ "$(cat "${dir}/status.${finished}")" != 0 ]]; then
        failed_files=$((failed_files + 1))
        if [[ $BAIL == true ]]; then
          stop=true
        fi
      fi
      echo
      finished=$((finished + 1))
      progressed=true
    done

    running=0
    for ((index = finished; index < started; index++)); do
      if [[ ! -f "${dir}/status.${index}" ]]; then
        running=$((running + 1))
      fi
    done

    while [[ $started -lt $count && $running -lt $PARALLEL && $stop == false ]]; do
      (
        run_file_child "${files[$started]}" "${job_events:+${dir}/events.${started}}" >"${dir}/out.${started}" 2>&1
        echo $? >"${dir}/status.${started}"
      ) &
      started=$((started + 1))
      running=$((running + 1))
      progressed=true
    done

    if [[ $finished -ge $started ]]; then
      break
    fi
    if [[ $progressed == false ]]; then
      sleep 0.05
    fi
  done

  wait
  skipped_files=$((count - started))
  rm -rf "$dir"
}

run_files() {
  local test_file
  local total_files=0 failed_files=0 skipped_files=0
  local passed=0 failed=0 skipped=0 todo=0
  local file_passed file_failed file_skipped file_todo
  local results_file
  results_file="$(mktemp)"
  local started_at
  started_at="$(now)"
  local coverage_file=''
  if [[ $COVERAGE == true ]]; then
    coverage_file="$(mktemp)"
  fi

  local events_file=''
  local quiet=false
  if [[ $REPORTER != default ]]; then
    events_file="$(mktemp)"
    if [[ -z $OUTPUT_FILE ]]; then
      quiet=true
    fi
  fi

  # With a machine-readable reporter on stdout, the human output is discarded.
  if [[ $quiet == true ]]; then
    exec 3>&1 1>/dev/null
  fi

  if [[ $PARALLEL -gt 1 ]]; then
    run_files_parallel "$@"
  else
    for test_file in "$@"; do
      total_files=$((total_files + 1))
      rule "$test_file"

      if ! run_file_child "$test_file" "$events_file"; then
        failed_files=$((failed_files + 1))
        if [[ $BAIL == true ]]; then
          skipped_files=$(($# - total_files))
          echo
          break
        fi
      fi
      echo
    done
  fi

  while read -r file_passed file_failed file_skipped file_todo; do
    passed=$((passed + file_passed))
    failed=$((failed + file_failed))
    skipped=$((skipped + file_skipped))
    todo=$((todo + file_todo))
  done <"$results_file"
  rm -f "$results_file"

  local coverage_status="$EXIT_SUCCESS"
  if [[ -n $coverage_file ]]; then
    report_coverage "$coverage_file" || coverage_status="$EXIT_FAILURE"
    rm -f "$coverage_file"
    echo
  fi

  rule
  echo "${C_BOLD}Test Files:${C_RESET}  $(format_counts "$total_files" "$((total_files - failed_files))" "$failed_files" 0)"
  print_summary "$((passed + failed + skipped + todo))" "$passed" "$failed" "$skipped" "$todo"
  echo "${C_BOLD}Time:${C_RESET}        ${C_YELLOW}$(elapsed_since "$started_at")s${C_RESET}"
  if [[ $skipped_files -gt 0 ]]; then
    echo
    echo "${C_YELLOW}Bailed after the first failing file: ${skipped_files} file(s) not run${C_RESET}"
  fi

  if [[ $quiet == true ]]; then
    exec 1>&3 3>&-
  fi

  if [[ -n $events_file ]]; then
    if [[ -n $OUTPUT_FILE ]]; then
      emit_report "$events_file" >"$OUTPUT_FILE"
    else
      emit_report "$events_file"
    fi
    rm -f "$events_file"
  fi

  [[ $failed_files -eq 0 && $coverage_status -eq $EXIT_SUCCESS ]]
}

# Check the settings that can come from either the config file or the command line.
validate_settings() {
  local reporter

  if [[ ! $PARALLEL =~ ^[1-9][0-9]*$ ]]; then
    echo "shest: PARALLEL must be a positive integer, got: ${PARALLEL}" >&2
    return "$EXIT_FAILURE"
  fi
  if [[ ! $TEST_TIMEOUT =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "shest: TEST_TIMEOUT must be a number of seconds, got: ${TEST_TIMEOUT}" >&2
    return "$EXIT_FAILURE"
  fi
  for reporter in "${COVERAGE_REPORTERS[@]}"; do
    case "$reporter" in
      text) ;;
      lcov | cobertura) COVERAGE=true ;;
      *)
        echo "shest: unknown coverage reporter: ${reporter} (use text, lcov or cobertura)" >&2
        return "$EXIT_FAILURE"
        ;;
    esac
  done
}

# Print every file git reports as modified, staged or untracked (absolute paths).
changed_files() {
  local root

  if ! root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    echo "shest: --changed needs a git repository" >&2
    return "$EXIT_FAILURE"
  fi
  {
    git -C "$root" diff --name-only HEAD 2>/dev/null
    git -C "$root" ls-files --others --exclude-standard
  } | sort -u | while IFS= read -r file; do
    echo "${root}/${file}"
  done
}

# Keep only the test files that changed or that mention a changed file by name.
select_changed_tests() {
  local changed test_file changed_file physical
  changed="$(changed_files)" || return "$EXIT_FAILURE"

  for test_file in "$@"; do
    # git prints real paths, so compare against the physical path of the file.
    physical="$(cd "$(dirname "$test_file")" && pwd -P)/$(basename "$test_file")"
    if grep -qxF -- "$physical" <<<"$changed"; then
      echo "$test_file"
      continue
    fi
    while IFS= read -r changed_file; do
      if [[ -n $changed_file && $changed_file != *.test.sh && -f $changed_file ]] && grep -qF -- "$(basename "$changed_file")" "$test_file"; then
        echo "$test_file"
        break
      fi
    done <<<"$changed"
  done
}

# Print the tests of every file without running them.
list_tests() {
  local test_file
  local total=0 run=0 skipped=0 todo=0 only=0
  local index mode name timeout has_only

  for test_file in "$@"; do
    rule "$test_file"
    TEST_NAMES=() TEST_FUNCTIONS=() TEST_MODES=() TEST_TIMEOUTS=()
    discover_tests "$test_file" || return "$EXIT_FAILURE"
    has_only=false
    for mode in "${TEST_MODES[@]}"; do
      if [[ $mode == only ]]; then
        has_only=true
      fi
    done
    for index in "${!TEST_NAMES[@]}"; do
      name="${TEST_NAMES[$index]}"
      mode="${TEST_MODES[$index]}"
      timeout="${TEST_TIMEOUTS[$index]}"
      if [[ -n $NAME_FILTER && ! $name =~ $NAME_FILTER ]]; then
        continue
      fi
      total=$((total + 1))
      # With an .only test in the file, the plain tests do not run.
      if [[ $mode == run && $has_only == true ]]; then
        mode=skip
      fi
      case "$mode" in
        skip)
          skipped=$((skipped + 1))
          printf '%s○%s %s%s (skip)%s' "$C_YELLOW" "$C_RESET" "$C_DIM" "$name" "$C_RESET"
          ;;
        todo)
          todo=$((todo + 1))
          printf '%s✎%s %s%s (todo)%s' "$C_CYAN" "$C_RESET" "$C_DIM" "$name" "$C_RESET"
          ;;
        only)
          only=$((only + 1))
          printf '%s▶%s %s %s(only)%s' "$C_BLUE" "$C_RESET" "$name" "$C_BLUE" "$C_RESET"
          ;;
        *)
          run=$((run + 1))
          printf '%s•%s %s' "$C_GREEN" "$C_RESET" "$name"
          ;;
      esac
      if [[ -n $timeout ]]; then
        printf ' %s(timeout %ss)%s' "$C_DIM" "$timeout" "$C_RESET"
      fi
      echo
    done
    echo
  done

  rule
  echo "${C_BOLD}Test Files:${C_RESET}  $#"
  echo "${C_BOLD}Tests:${C_RESET}       $(format_list_counts "$total" "$run" "$only" "$skipped" "$todo")"
}

# "1 skipped, 2 todo, 1 only, 8 to run, 12 total" (zero counts are omitted).
format_list_counts() {
  local total="$1" run="$2" only="$3" skipped="$4" todo="$5"
  local parts=()

  if [[ $skipped -gt 0 ]]; then
    parts+=("${C_YELLOW}${skipped} skipped${C_RESET}")
  fi
  if [[ $todo -gt 0 ]]; then
    parts+=("${C_CYAN}${todo} todo${C_RESET}")
  fi
  if [[ $only -gt 0 ]]; then
    parts+=("${C_BLUE}${only} only${C_RESET}")
  fi
  parts+=("${C_GREEN}$((run + only)) to run${C_RESET}")
  parts+=("${total} total")

  local out="${parts[0]}" part
  for part in "${parts[@]:1}"; do
    out+=", ${part}"
  done
  echo "$out"
}

# Create shest.config.sh in the current directory.
init_config() {
  if [[ -e shest.config.sh ]]; then
    echo "shest: shest.config.sh already exists" >&2
    return "$EXIT_FAILURE"
  fi
  cat >shest.config.sh <<'EOF'
# shest configuration. Plain bash, sourced before the command line is parsed,
# so command-line options always win. Every setting is optional; the values
# below are the defaults.
#
# Path patterns are literal substrings of the file path (like Jest's
# testPathIgnorePatterns), not globs.

# Where to look when no path is given. Directories and globs; "**" matches any depth.
# TEST_MATCH=("tests/**/*.test.sh")

# Test files whose path contains any of these are skipped.
# TEST_PATH_IGNORE_PATTERNS=("/build/" "/dist/" "/node_modules/")

# Print a coverage report. A threshold (integer percentage) makes the run fail below it.
# COVERAGE=true
# COVERAGE_THRESHOLD=80
# COVERAGE_PATH_IGNORE_PATTERNS=("/vendor/")

# Coverage output: text (console table), lcov and cobertura (files in COVERAGE_DIRECTORY).
# COVERAGE_REPORTERS=(text lcov)
# COVERAGE_DIRECTORY=coverage

# Stop after the first failing file.
# BAIL=true

# Run up to this many test files at the same time.
# PARALLEL=4

# Kill any test that runs longer than this many seconds (0 = no limit).
# A "# @timeout <seconds>" line above a test overrides it.
# TEST_TIMEOUT=30

# Print how long each test took.
# TIMING=true

# default, tap or junit; OUTPUT_FILE writes the report to a file instead of stdout.
# REPORTER=junit
# OUTPUT_FILE=report.xml

# Only run tests whose name matches this regex.
# NAME_FILTER=''
EOF
  echo "Created shest.config.sh"
}

# Run shest again every time a .sh file changes: watch_loop <shest args>
watch_loop() {
  local marker
  marker="$(mktemp)"
  trap 'rm -f "$marker"; exit 0' INT TERM

  while true; do
    if [[ -t 1 ]]; then
      printf '\033[2J\033[H'
    fi
    # The marker is touched before the run, so edits made during it trigger another one.
    touch "$marker"
    bash "$SHEST_SELF" "$@" || true
    echo
    echo "${C_DIM}Watching for changes... press Ctrl-C to quit.${C_RESET}"
    while [[ -z "$(find . -type f -name '*.sh' -not -path './.git/*' -newer "$marker" 2>/dev/null | head -n 1)" ]]; do
      sleep 1
    done
  done
}

main() {
  local patterns=()
  local run_file=''
  local files=()
  local pattern
  local test_file
  local config=''
  local arg
  local is_child=false
  local previous=''
  local original_args=("$@")

  # Config comes first so command-line options override it.
  for arg in "$@"; do
    if [[ $previous == --config ]]; then
      config="$arg"
    elif [[ $arg == --run-file ]]; then
      is_child=true
    fi
    previous="$arg"
  done
  if [[ -z $config && -f shest.config.sh ]]; then
    config='shest.config.sh'
  fi
  if [[ -n $config && $is_child == false ]]; then
    load_config "$config" || return "$EXIT_FAILURE"
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        shift 2 || break
        ;;
      -h | --help)
        usage
        return "$EXIT_SUCCESS"
        ;;
      -v | --version)
        echo "shest ${SHEST_VERSION}"
        return "$EXIT_SUCCESS"
        ;;
      -t | --filter)
        NAME_FILTER="${2:-}"
        shift 2 || break
        ;;
      --coverage)
        COVERAGE=true
        shift
        ;;
      --coverage-reporters)
        IFS=',' read -r -a COVERAGE_REPORTERS <<<"${2:-}"
        shift 2 || break
        ;;
      --coverage-directory)
        COVERAGE_DIRECTORY="${2:-}"
        shift 2 || break
        ;;
      --parallel)
        PARALLEL="${2:-}"
        shift 2 || break
        ;;
      --timeout)
        TEST_TIMEOUT="${2:-}"
        shift 2 || break
        ;;
      --changed)
        CHANGED=true
        shift
        ;;
      --list)
        LIST=true
        shift
        ;;
      --watch)
        WATCH=true
        shift
        ;;
      --init)
        INIT=true
        shift
        ;;
      --bail)
        BAIL=true
        shift
        ;;
      --timing)
        TIMING=true
        shift
        ;;
      --reporter)
        REPORTER="${2:-}"
        case "$REPORTER" in
          default | tap | junit) ;;
          *)
            echo "shest: unknown reporter: ${REPORTER} (use default, tap or junit)" >&2
            return "$EXIT_FAILURE"
            ;;
        esac
        shift 2
        ;;
      --output-file)
        OUTPUT_FILE="${2:-}"
        shift 2 || break
        ;;
      --coverage-threshold)
        COVERAGE=true
        COVERAGE_THRESHOLD="${2:-}"
        shift 2 || break
        ;;
      --run-file)
        run_file="$2"
        shift 2
        ;;
      -p | --path | -f | --file)
        shift
        while [[ $# -gt 0 && $1 != -* ]]; do
          patterns+=("$1")
          shift
        done
        ;;
      -*)
        echo "shest: unknown option: $1" >&2
        usage >&2
        return "$EXIT_FAILURE"
        ;;
      *)
        patterns+=("$1")
        shift
        ;;
    esac
  done

  if [[ -n $run_file ]]; then
    run_tests "$run_file"
    return
  fi

  if [[ $INIT == true ]]; then
    init_config
    return
  fi

  validate_settings || return "$EXIT_FAILURE"

  if [[ $WATCH == true ]]; then
    local watch_args=()
    for arg in "${original_args[@]}"; do
      if [[ $arg != --watch ]]; then
        watch_args+=("$arg")
      fi
    done
    watch_loop "${watch_args[@]}"
    return
  fi

  if [[ ${#patterns[@]} -eq 0 && ${#TEST_MATCH[@]} -gt 0 ]]; then
    patterns=("${TEST_MATCH[@]}")
  fi
  if [[ ${#patterns[@]} -eq 0 ]]; then
    patterns=("$DEFAULT_TEST_PATH")
  fi

  for pattern in "${patterns[@]}"; do
    while IFS= read -r test_file; do
      if [[ -n $test_file ]] && ! is_test_ignored "$test_file"; then
        files+=("$test_file")
      fi
    done < <(resolve_pattern "$pattern")
  done

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "shest: no test files found for: ${patterns[*]}" >&2
    return "$EXIT_FAILURE"
  fi

  if [[ $CHANGED == true ]]; then
    changed_files >/dev/null || return "$EXIT_FAILURE"
    local selected=()
    while IFS= read -r test_file; do
      selected+=("$test_file")
    done < <(select_changed_tests "${files[@]}")
    if [[ ${#selected[@]} -eq 0 ]]; then
      echo "shest: no test files are affected by the changed files"
      return "$EXIT_SUCCESS"
    fi
    files=("${selected[@]}")
  fi

  if [[ $LIST == true ]]; then
    list_tests "${files[@]}"
    return
  fi

  run_files "${files[@]}"
}

main "$@"
