#!/usr/bin/env bash

# Resolve symlinks (e.g. ~/.local/bin/shest -> ~/.shest/shest.sh) so utils/ is found next to the real script.
SHEST_SOURCE="${BASH_SOURCE[0]}"
while [[ -L $SHEST_SOURCE ]]; do
  SHEST_LINK_DIR="$(cd "$(dirname "$SHEST_SOURCE")" && pwd)"
  SHEST_SOURCE="$(readlink "$SHEST_SOURCE")"
  if [[ $SHEST_SOURCE != /* ]]; then
    SHEST_SOURCE="${SHEST_LINK_DIR}/${SHEST_SOURCE}"
  fi
done
SHEST_DIR="$(cd "$(dirname "$SHEST_SOURCE")" && pwd)"
source "${SHEST_DIR}/utils/colors.sh"

readonly SHEST_VERSION="2.0.0"
readonly EXIT_SUCCESS=0
readonly EXIT_FAILURE=1
readonly INITIAL_FAILURE_COUNT=0
readonly OUTPUT_INDENT='    '
readonly TEST_ANNOTATION_PATTERN='^#[[:space:]]*@test(\.only|\.skip)?[[:space:]]+(.+)$'
readonly TEST_FILE_NAME_PATTERN='*.test.sh'
readonly DEFAULT_TEST_PATH='.'
readonly ALL_FILES_LABEL='All files'
readonly LINES_HEADER='Lines'
readonly UNCOVERED_HEADER='Uncovered Line #s'
SHEST_SELF="${SHEST_DIR}/$(basename "$SHEST_SOURCE")"
readonly SHEST_SELF
readonly FUNCTION_DECLARATION_PATTERN='^(function[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*(\(\))?[[:space:]]*\{?'

TEST_NAMES=()
TEST_FUNCTIONS=()
TEST_MODES=()
NAME_FILTER=''
COVERAGE=false
BAIL=false
TIMING=false
REPORTER='default'
OUTPUT_FILE=''
COVERAGE_THRESHOLD=''
# Config-file settings (see shest.config.sh). Arrays hold literal path substrings.
TEST_MATCH=()
TEST_PATH_IGNORE_PATTERNS=()
COVERAGE_PATH_IGNORE_PATTERNS=()

# shellcheck disable=SC2016  # awk program, no shell expansion wanted
readonly COVERAGE_AWK_PROGRAM='
# Line coverage for one file. Input 1: hit line numbers. Input 2: the source file.
# Prints "<executable> <covered> <uncovered ranges>".
function finalize(   ) {
  if (g_exec) {
    total++
    if (g_hit) { covered++ } else { miss[++missing] = g_start }
  }
}
function is_executable(l) {
  if (l ~ /^[ \t]*$/) return 0
  if (l ~ /^[ \t]*#/) return 0
  if (l ~ /^[ \t]*(\{|\}|fi|done|then|else|esac|do|;;|\))[ \t]*$/) return 0
  if (l ~ /^[ \t]*(function[ \t]+)?[A-Za-z_][A-Za-z0-9_]*[ \t]*(\(\))?[ \t]*\{?[ \t]*$/ && l ~ /(\(\)|^[ \t]*function)/) return 0
  if (l ~ /^[ \t]*[^ \t(#][^()]*\)[ \t]*$/) return 0
  return 1
}
NR == FNR { hit[$1] = 1; next }
{
  line = $0
  if (heredoc != "") {
    if (line ~ ("^[ \t]*" heredoc "[ \t]*$")) heredoc = ""
    next
  }
  if (cont) {
    if (hit[FNR]) g_hit = 1
  } else {
    finalize()
    g_start = FNR
    g_exec = is_executable(line)
    g_hit = hit[FNR] ? 1 : 0
  }
  if (in_arr) {
    if (line ~ /^[ \t]*\)[ \t]*$/) in_arr = 0
    cont = in_arr
  } else if (line ~ /=\([ \t]*$/) {
    in_arr = 1
    cont = 1
  } else {
    cont = (line ~ /\\[ \t]*$/)
  }
  if (g_exec && match(line, /<<-?[ \t]*["\x27\\]?[A-Za-z_][A-Za-z0-9_]*/) && substr(line, RSTART - 1, 1) != "<") {
    marker = substr(line, RSTART, RLENGTH)
    sub(/^<<-?[ \t]*["\x27\\]?/, "", marker)
    heredoc = marker
  }
}
END {
  finalize()
  ranges = ""
  for (i = 1; i <= missing; i++) {
    start = miss[i]; stop = start
    while (i < missing && miss[i + 1] <= stop + 1) { i++; stop = miss[i] }
    ranges = ranges (ranges == "" ? "" : ", ") (start == stop ? start : start "-" stop)
  }
  print total + 0, covered + 0, ranges
}
'

to_be() {
  local actual="$1"
  local expected="$2"

  if [[ "$actual" != "$expected" ]]; then
    echo "Expected: $expected"
    echo "Received: $actual"
    return "$EXIT_FAILURE"
  fi
}

not_to_be() {
  local actual="$1"
  local expected="$2"

  if [[ "$actual" == "$expected" ]]; then
    echo "Expected: $expected"
    echo "Received: $actual"
    return "$EXIT_FAILURE"
  fi
}

# Numeric comparison (supports decimals): __compare <a> <operator> <b>
__compare() {
  awk -v a="$1" -v b="$3" "BEGIN { exit !(a $2 b) }"
}

__assert_compare() {
  local actual="$1"
  local operator="$2"
  local expected="$3"
  local description="$4"

  if ! __compare "$actual" "$operator" "$expected"; then
    echo "Expected: ${actual} ${description} ${expected}"
    return "$EXIT_FAILURE"
  fi
}

to_be_greater_than() { __assert_compare "$1" '>' "$2" 'to be greater than'; }
to_be_greater_than_or_equal() { __assert_compare "$1" '>=' "$2" 'to be greater than or equal to'; }
to_be_less_than() { __assert_compare "$1" '<' "$2" 'to be less than'; }
to_be_less_than_or_equal() { __assert_compare "$1" '<=' "$2" 'to be less than or equal to'; }

to_be_true() {
  if [[ "$1" != "true" ]]; then
    echo "Expected: true"
    echo "Received: $1"
    return "$EXIT_FAILURE"
  fi
}

to_be_false() {
  if [[ "$1" != "false" ]]; then
    echo "Expected: false"
    echo "Received: $1"
    return "$EXIT_FAILURE"
  fi
}

# Extended regular expression match: expect "$text" to_match 'stop'
to_match() {
  if ! [[ "$1" =~ $2 ]]; then
    echo "Expected: to match /$2/"
    echo "Received: $1"
    return "$EXIT_FAILURE"
  fi
}

# Substring match: expect "$text" to_contain 'sub'
to_contain() {
  if [[ "$1" != *"$2"* ]]; then
    echo "Expected: to contain $2"
    echo "Received: $1"
    return "$EXIT_FAILURE"
  fi
}

# Exact element match on a newline-separated list:
#   expect "$(printf '%s\n' "${items[@]}")" to_contain_item milk
to_contain_item() {
  if ! grep -qxF -- "$2" <<<"$1"; then
    echo "Expected: list to contain item $2"
    echo "Received: ${1//$'\n'/, }"
    return "$EXIT_FAILURE"
  fi
}

# Default no-op hooks; a test file overrides them by defining functions
# with the same names.
before_each() { :; }
after_each() { :; }
before_all() { :; }
after_all() { :; }

expect() {
  local actual="$1"
  local matcher="$2"
  shift 2

  "$matcher" "$actual" "$@"
}

# Collect "# @test[.only|.skip] <name>" annotations and the function declared
# right after each one.
discover_tests() {
  local source_file="$1"
  local line
  local line_number=0
  local pending_name=''
  local pending_mode='run'
  local pending_line=0

  while IFS= read -r line; do
    line_number=$((line_number + 1))

    if [[ -n $pending_name ]]; then
      if [[ $line =~ $FUNCTION_DECLARATION_PATTERN ]]; then
        TEST_NAMES+=("$pending_name")
        TEST_FUNCTIONS+=("${BASH_REMATCH[2]}")
        TEST_MODES+=("$pending_mode")
        pending_name=''
        continue
      fi
      echo "${source_file}:${pending_line}: '# @test' must be followed by a function declaration" >&2
      return "$EXIT_FAILURE"
    fi

    if [[ $line =~ $TEST_ANNOTATION_PATTERN ]]; then
      pending_mode="${BASH_REMATCH[1]#.}"
      pending_mode="${pending_mode:-run}"
      pending_name="${BASH_REMATCH[2]}"
      pending_line=$line_number
    fi
  done <"$source_file"

  if [[ -n $pending_name ]]; then
    echo "${source_file}:${pending_line}: '# @test' must be followed by a function declaration" >&2
    return "$EXIT_FAILURE"
  fi
}

# Jest-style counts: "2 skipped, 1 failed, 551 passed, 552 total" (zero failed/skipped are omitted).
format_counts() {
  local total="$1" passed="$2" failed="$3" skipped="$4"
  local parts=()

  if [[ $skipped -gt 0 ]]; then
    parts+=("${C_YELLOW}${skipped} skipped${C_RESET}")
  fi
  if [[ $failed -gt 0 ]]; then
    parts+=("${C_RED}${failed} failed${C_RESET}")
  fi
  parts+=("${C_GREEN}${passed} passed${C_RESET}")
  parts+=("${total} total")

  local out="${parts[0]}" part
  for part in "${parts[@]:1}"; do
    out+=", ${part}"
  done
  echo "$out"
}

print_summary() {
  echo "${C_BOLD}Tests:${C_RESET}       $(format_counts "$@")"
}

# A full-width horizontal rule, optionally with a title: rule [title]
rule() {
  local title="${1:-}"
  local width=68
  local fill

  if [[ -n $title ]]; then
    fill="$(printf '%*s' "$((width - ${#title} - 4))" '' | tr ' ' '━')"
    echo "${C_BOLD}${C_DIM}━━${C_RESET} ${C_CYAN}${title}${C_RESET} ${C_DIM}${fill}${C_RESET}"
  else
    echo "${C_DIM}$(printf '%*s' "$width" '' | tr ' ' '─')${C_RESET}"
  fi
}

# Print <text> with every line prefixed by OUTPUT_INDENT.
indent_output() {
  echo "${OUTPUT_INDENT}${1//$'\n'/$'\n'${OUTPUT_INDENT}}"
}

# Decide whether the test at <index> is skipped (skip / only / name filter).
is_skipped() {
  local index="$1"
  local has_only="$2"

  if [[ ${TEST_MODES[$index]} == skip ]]; then
    return 0
  fi
  if [[ $has_only == true && ${TEST_MODES[$index]} != only ]]; then
    return 0
  fi
  if [[ -n $NAME_FILTER && ! ${TEST_NAMES[$index]} =~ $NAME_FILTER ]]; then
    return 0
  fi
  return 1
}

# Run one test file in this process. When SHEST_RESULTS_FILE is set, append
# "<passed> <failed> <skipped>" to it instead of printing a summary.
run_tests() {
  local test_file="$1"

  discover_tests "$test_file" || return "$EXIT_FAILURE"
  if [[ -n ${SHEST_COVERAGE_FILE:-} ]]; then
    enable_coverage
  fi
  # shellcheck disable=SC1090
  source "$test_file"

  local failed="$INITIAL_FAILURE_COUNT"
  local passed=0
  local skipped=0
  local has_only=false
  local index
  local output
  local status

  for index in "${!TEST_MODES[@]}"; do
    if [[ ${TEST_MODES[$index]} == only ]]; then
      has_only=true
    fi
  done

  local runnable=0
  for index in "${!TEST_NAMES[@]}"; do
    is_skipped "$index" "$has_only" || runnable=$((runnable + 1))
  done

  if [[ $runnable -gt 0 ]]; then
    before_all
  fi

  local measure=false
  if [[ ${SHEST_TIMING:-} == true || -n ${SHEST_EVENTS_FILE:-} ]]; then
    measure=true
  fi

  local test_started='' seconds='0.000' timing_label=''

  for index in "${!TEST_NAMES[@]}"; do
    if is_skipped "$index" "$has_only"; then
      echo "${C_YELLOW}○${C_RESET} ${C_DIM}${TEST_NAMES[$index]} (skipped)${C_RESET}"
      if [[ -n ${SHEST_EVENTS_FILE:-} ]]; then
        record_event "$test_file" skip 0.000 "${TEST_NAMES[$index]}" ''
      fi
      skipped=$((skipped + 1))
      continue
    fi

    if [[ $measure == true ]]; then
      test_started="$(now)"
    fi

    output="$( (
      set -e
      trap after_each EXIT
      before_each
      "${TEST_FUNCTIONS[$index]}"
    ) 2>&1)"
    status=$?

    timing_label=''
    if [[ $measure == true ]]; then
      seconds="$(elapsed_seconds "$test_started")"
      if [[ ${SHEST_TIMING:-} == true ]]; then
        timing_label=" ${C_DIM}($((10#${seconds/./})) ms)${C_RESET}"
      fi
    fi

    if [[ $status -eq $EXIT_SUCCESS ]]; then
      echo "${C_GREEN}✓${C_RESET} ${TEST_NAMES[$index]}${timing_label}"
      if [[ -n $output ]]; then
        indent_output "$output"
        echo
      fi
      if [[ -n ${SHEST_EVENTS_FILE:-} ]]; then
        record_event "$test_file" pass "$seconds" "${TEST_NAMES[$index]}" "$output"
      fi
      passed=$((passed + 1))
    else
      echo "${C_RED}✗${C_RESET} ${TEST_NAMES[$index]}${timing_label}"
      indent_output "$output"
      echo
      if [[ -n ${SHEST_EVENTS_FILE:-} ]]; then
        record_event "$test_file" fail "$seconds" "${TEST_NAMES[$index]}" "$output"
      fi
      failed=$((failed + 1))
    fi
  done

  if [[ $runnable -gt 0 ]]; then
    after_all
  fi

  if [[ -n ${SHEST_RESULTS_FILE:-} ]]; then
    echo "$passed $failed $skipped" >>"$SHEST_RESULTS_FILE"
  else
    echo
    print_summary "${#TEST_NAMES[@]}" "$passed" "$failed" "$skipped"
  fi

  [[ $failed -eq $INITIAL_FAILURE_COUNT ]]
}

# Record "<file>:<line>" for every command executed, so coverage can be computed.
enable_coverage() {
  set -T
  trap 'printf "%s:%s\n" "${BASH_SOURCE[0]}" "$LINENO" >>"$SHEST_COVERAGE_FILE"' DEBUG
}

# Resolve a path (possibly relative) to an absolute one; prints nothing if the file is missing.
absolute_path() {
  local path="$1"

  if [[ -f $path ]]; then
    echo "$(cd "$(dirname "$path")" && pwd)/$(basename "$path")"
  fi
}

# Files that should not show up in the coverage report.
is_coverage_excluded() {
  local file="$1"

  local pattern

  case "$file" in
    "$SHEST_SELF" | "${SHEST_DIR}"/utils/* | *.test.sh) return 0 ;;
  esac
  for pattern in ${COVERAGE_PATH_IGNORE_PATTERNS[@]+"${COVERAGE_PATH_IGNORE_PATTERNS[@]}"}; do
    if [[ $file == *"$pattern"* ]]; then
      return 0
    fi
  done
  return 1
}

# True when a test file path contains one of TEST_PATH_IGNORE_PATTERNS.
is_test_ignored() {
  local path="/${1#./}"
  local pattern

  for pattern in ${TEST_PATH_IGNORE_PATTERNS[@]+"${TEST_PATH_IGNORE_PATTERNS[@]}"}; do
    if [[ $path == *"$pattern"* ]]; then
      return 0
    fi
  done
  return 1
}

# Source a config file (plain bash that sets the settings above) and validate it.
load_config() {
  local config="$1"

  if [[ ! -f $config ]]; then
    echo "shest: config file not found: ${config}" >&2
    return "$EXIT_FAILURE"
  fi
  # shellcheck disable=SC1090
  source "$config"

  case "$REPORTER" in
    default | tap | junit) ;;
    *)
      echo "shest: ${config}: unknown REPORTER: ${REPORTER} (use default, tap or junit)" >&2
      return "$EXIT_FAILURE"
      ;;
  esac
  if [[ -n $COVERAGE_THRESHOLD ]]; then
    if [[ ! $COVERAGE_THRESHOLD =~ ^[0-9]+$ ]]; then
      echo "shest: ${config}: COVERAGE_THRESHOLD must be an integer, got: ${COVERAGE_THRESHOLD}" >&2
      return "$EXIT_FAILURE"
    fi
    COVERAGE=true
  fi
}

# Percentage with two decimals (integer math): format_percent <covered> <total>
format_percent() {
  local covered="$1"
  local total="$2"
  local hundredths=10000

  if [[ $total -gt 0 ]]; then
    hundredths=$((covered * 10000 / total))
  fi
  printf '%d.%02d' "$((hundredths / 100))" "$((hundredths % 100))"
}

# Jest-style color for a percentage: green >= 80, yellow >= 50, red below.
percent_color() {
  local covered="$1"
  local total="$2"

  if [[ $total -eq 0 || $((covered * 100)) -ge $((80 * total)) ]]; then
    echo "$C_GREEN"
  elif [[ $((covered * 100)) -ge $((50 * total)) ]]; then
    echo "$C_YELLOW"
  else
    echo "$C_RED"
  fi
}

# Repeat a character: repeat_char <char> <count>
repeat_char() {
  local out=''
  local i

  for ((i = 0; i < $2; i++)); do
    out+="$1"
  done
  printf '%s' "$out"
}

# Horizontal border: coverage_border <left> <middle> <right> <name w> <lines w> <ranges w>
coverage_border() {
  printf '%s%s%s%s%s%s%s%s%s%s%s\n' "$C_DIM" "$1" "$(repeat_char '─' $(($4 + 2)))" "$2" "$(repeat_char '─' 9)" "$2" \
    "$(repeat_char '─' $(($5 + 2)))" "$2" "$(repeat_char '─' $(($6 + 2)))" "$3" "$C_RESET"
}

# Print one table row: <name> <percent text> <color> <lines text> <uncovered> <name width> <lines width> <ranges width> [bold]
print_coverage_row() {
  local name="$1" percent="$2" color="$3" lines="$4" ranges="${5//, /,}"
  local name_width="$6" lines_width="$7" ranges_width="$8" bold="${9:-}"
  local bar="${C_DIM}│${C_RESET}"
  local uncovered=$((${lines#*/} - ${lines%/*}))
  local ranges_color="$C_YELLOW"

  # Uncovered lines in total (not groups): up to 3 yellow, more red.
  if [[ $uncovered -gt 3 ]]; then
    ranges_color="$C_RED"
  fi

  printf '%s %s%s%-*s%s %s %s%7s%s %s %*s %s %s%-*s%s %s\n' "$bar" "$bold" "$color" "$name_width" "$name" "$C_RESET" "$bar" \
    "$color" "$percent" "$C_RESET" "$bar" "$lines_width" "$lines" "$bar" "$ranges_color" "$ranges_width" "$ranges" "$C_RESET" "$bar"
}

# Jest-style table: print_coverage_table <rows> <total lines> <total covered>
# rows: one "name|lines|covered|percent|ranges" per line.
print_coverage_table() {
  local rows="$1"
  local total_lines="$2"
  local total_covered="$3"
  local name lines covered percent ranges
  local name_width=${#ALL_FILES_LABEL}
  local lines_width=${#LINES_HEADER}
  local ranges_width=${#UNCOVERED_HEADER}

  while IFS='|' read -r name lines covered percent ranges; do
    if [[ -z $name ]]; then
      continue
    fi
    ranges="${ranges//, /,}"
    if [[ ${#name} -gt $name_width ]]; then
      name_width=${#name}
    fi
    if [[ $((${#covered} + ${#lines} + 1)) -gt $lines_width ]]; then
      lines_width=$((${#covered} + ${#lines} + 1))
    fi
    if [[ ${#ranges} -gt $ranges_width ]]; then
      ranges_width=${#ranges}
    fi
  done <<<"$rows"
  if [[ $((${#total_covered} + ${#total_lines} + 1)) -gt $lines_width ]]; then
    lines_width=$((${#total_covered} + ${#total_lines} + 1))
  fi

  local bar="${C_DIM}│${C_RESET}"
  coverage_border '┌' '┬' '┐' "$name_width" "$lines_width" "$ranges_width"
  printf '%s %s%-*s%s %s %7s %s %*s %s %s%-*s%s %s\n' "$bar" "$C_BOLD" "$name_width" 'File' "$C_RESET" "$bar" '% Lines' "$bar" "$lines_width" 'Lines' "$bar" \
    "$C_BOLD" "$ranges_width" "$UNCOVERED_HEADER" "$C_RESET" "$bar"
  coverage_border '├' '┼' '┤' "$name_width" "$lines_width" "$ranges_width"
  print_coverage_row "$ALL_FILES_LABEL" "$(format_percent "$total_covered" "$total_lines")" "$(percent_color "$total_covered" "$total_lines")" "${total_covered}/${total_lines}" '' "$name_width" "$lines_width" "$ranges_width" "$C_BOLD"
  while IFS='|' read -r name lines covered percent ranges; do
    if [[ -z $name ]]; then
      continue
    fi
    print_coverage_row "$name" "$(format_percent "$covered" "$lines")" "$(percent_color "$covered" "$lines")" "${covered}/${lines}" "$ranges" "$name_width" "$lines_width" "$ranges_width"
  done <<<"$rows"
  coverage_border '└' '┴' '┘' "$name_width" "$lines_width" "$ranges_width"
  echo
  printf '%sCoverage%s: %s%s%%%s (%s/%s lines)\n' "$C_BOLD" "$C_RESET" "$(percent_color "$total_covered" "$total_lines")" "$(format_percent "$total_covered" "$total_lines")" "$C_RESET" "$total_covered" "$total_lines"
}

# Print the coverage table for the hits in <hits_file>; fails when below the threshold.
report_coverage() {
  local hits_file="$1"
  local normalized_file
  normalized_file="$(mktemp)"
  local file_hits
  file_hits="$(mktemp)"
  local raw absolute
  local total_lines=0 total_covered=0
  local lines covered ranges percent
  local rows=''

  while IFS= read -r raw; do
    absolute="$(absolute_path "$raw")"
    if [[ -z $absolute ]] || is_coverage_excluded "$absolute"; then
      continue
    fi
    awk -F: -v raw="$raw" -v absolute="$absolute" '{ line = $NF; path = substr($0, 1, length($0) - length(line) - 1); if (path == raw) print absolute ":" line }' "$hits_file" >>"$normalized_file"
  done < <(awk '{ sub(/:[0-9]+$/, ""); print }' "$hits_file" | sort -u)

  while IFS= read -r absolute; do
    awk -F: -v absolute="$absolute" '{ line = $NF; path = substr($0, 1, length($0) - length(line) - 1); if (path == absolute) print line }' "$normalized_file" >"$file_hits"
    read -r lines covered ranges < <(awk "$COVERAGE_AWK_PROGRAM" "$file_hits" "$absolute")
    total_lines=$((total_lines + lines))
    total_covered=$((total_covered + covered))
    percent=0
    if [[ $lines -gt 0 ]]; then
      percent=$((covered * 100 / lines))
    fi
    rows+="${absolute#"$PWD"/}|${lines}|${covered}|${percent}|${ranges}"$'\n'
  done < <(sed 's/:[0-9]*$//' "$normalized_file" | sort -u)

  rm -f "$normalized_file" "$file_hits"

  if [[ -z $rows ]]; then
    echo "${C_BOLD}Coverage${C_RESET}: no source files were executed"
    return "$EXIT_SUCCESS"
  fi

  print_coverage_table "$rows" "$total_lines" "$total_covered"

  local total_percent=100
  if [[ $total_lines -gt 0 ]]; then
    total_percent=$((total_covered * 100 / total_lines))
  fi

  if [[ -n $COVERAGE_THRESHOLD && $((total_covered * 100)) -lt $((COVERAGE_THRESHOLD * total_lines)) ]]; then
    echo "${C_RED}Coverage $(format_percent "$total_covered" "$total_lines")% is below the threshold of ${COVERAGE_THRESHOLD}%${C_RESET}" >&2
    return "$EXIT_FAILURE"
  fi
}

# Current time in seconds (sub-second precision when bash 5 or perl is available).
now() {
  if [[ -n ${EPOCHREALTIME:-} ]]; then
    echo "${EPOCHREALTIME/,/.}"
  elif command -v perl >/dev/null 2>&1; then
    perl -MTime::HiRes=time -e 'printf "%.6f\n", time'
  else
    date +%s
  fi
}

# Seconds elapsed since a now() value, with three decimals.
elapsed_seconds() {
  awk -v start="$1" -v end="$(now)" 'BEGIN { printf "%.3f", end - start }'
}

# Seconds elapsed between two now() values, with two decimals.
elapsed_since() {
  awk -v start="$1" -v end="$(now)" 'BEGIN { printf "%.2f", end - start }'
}

# Shared awk helpers: events are tab separated "file status seconds name output",
# with \\, \n and \t escaped inside name and output.
# shellcheck disable=SC2016  # awk program, no shell expansion wanted
readonly REPORT_AWK_COMMON='
function unescape(s,   result, i, c, n) {
  result = ""
  n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c == "\\" && i < n) {
      i++
      c = substr(s, i, 1)
      if (c == "n") c = "\n"
      else if (c == "t") c = "\t"
    }
    result = result c
  }
  return result
}
BEGIN { FS = "\t" }
{
  n++
  file[n] = $1; status[n] = $2; seconds[n] = $3
  name[n] = unescape($4); output[n] = unescape($5)
}
'

# shellcheck disable=SC2016
readonly TAP_AWK_PROGRAM='
END {
  print "TAP version 13"
  print "1.." n
  for (i = 1; i <= n; i++) {
    label = name[i]
    gsub(/#/, "\\#", label)
    if (status[i] == "pass") { pass++; printf "ok %d - %s\n", i, label }
    else if (status[i] == "skip") { skip++; printf "ok %d - %s # SKIP\n", i, label }
    else {
      fail++
      printf "not ok %d - %s\n", i, label
      print "  ---"
      print "  file: " file[i]
      print "  output: |"
      count = split(output[i], lines, "\n")
      for (j = 1; j <= count; j++) print "    " lines[j]
      print "  ..."
    }
  }
  print "# tests " n
  print "# pass " pass + 0
  print "# fail " fail + 0
  print "# skip " skip + 0
}
'

# shellcheck disable=SC2016
readonly JUNIT_AWK_PROGRAM='
function xml(s) {
  gsub(/&/, "\\&amp;", s)
  gsub(/</, "\\&lt;", s)
  gsub(/>/, "\\&gt;", s)
  gsub(/"/, "\\&quot;", s)
  gsub(/[\001-\010\013\014\016-\037]/, "", s)
  return s
}
END {
  for (i = 1; i <= n; i++) {
    if (!(file[i] in tests)) order[++files] = file[i]
    tests[file[i]]++
    time[file[i]] += seconds[i]
    total_time += seconds[i]
    if (status[i] == "fail") { failures[file[i]]++; total_failures++ }
    if (status[i] == "skip") { skipped[file[i]]++; total_skipped++ }
  }
  print "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
  printf "<testsuites name=\"shest\" tests=\"%d\" failures=\"%d\" skipped=\"%d\" time=\"%.3f\">\n", n, total_failures, total_skipped, total_time
  for (f = 1; f <= files; f++) {
    current = order[f]
    printf "  <testsuite name=\"%s\" tests=\"%d\" failures=\"%d\" skipped=\"%d\" time=\"%.3f\">\n", xml(current), tests[current], failures[current], skipped[current], time[current]
    for (i = 1; i <= n; i++) {
      if (file[i] != current) continue
      printf "    <testcase classname=\"%s\" name=\"%s\" time=\"%.3f\"", xml(current), xml(name[i]), seconds[i]
      if (status[i] == "pass") { print "/>" }
      else if (status[i] == "skip") { print ">"; print "      <skipped/>"; print "    </testcase>" }
      else {
        split(output[i], lines, "\n")
        print ">"
        printf "      <failure message=\"%s\">%s</failure>\n", xml(lines[1]), xml(output[i])
        print "    </testcase>"
      }
    }
    print "  </testsuite>"
  }
  print "</testsuites>"
}
'

# Escape \, tab and newline so a value fits in one tab-separated field.
escape_field() {
  local value="$1"

  value="${value//\\/\\\\}"
  value="${value//$'\t'/\\t}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

# Append a test result to SHEST_EVENTS_FILE: record_event <file> <status> <seconds> <name> <output>
record_event() {
  printf '%s\t%s\t%s\t%s\t%s\n' "$(escape_field "$1")" "$2" "$3" "$(escape_field "$4")" "$(escape_field "$5")" >>"$SHEST_EVENTS_FILE"
}

# Print the TAP or JUnit report for <events_file> on stdout.
emit_report() {
  local events_file="$1"
  local program="$TAP_AWK_PROGRAM"

  if [[ $REPORTER == junit ]]; then
    program="$JUNIT_AWK_PROGRAM"
  fi
  awk "${REPORT_AWK_COMMON}${program}" "$events_file"
}

# One "<name>  <description>" row of the open help section; the name is bold.
help_row() {
  local name="$1"
  local description="$2"
  local width=30
  local plain colored

  plain="$(printf '%-*s %s' "$width" "$name" "$description")"
  colored="$(printf '%s%-*s%s %s' "$C_BOLD" "$width" "$name" "$C_RESET" "$description")"
  box_vis_row "${#plain}" "$colored"
}

usage() {
  # box-ui is only needed for the help screen, so it is loaded here to keep
  # its globals (WIDTH, BORDER, ...) out of the test runs.
  # shellcheck source=utils/ui/box-ui.sh
  source "${SHEST_DIR}/utils/ui/box-ui.sh"
  choose_box_width 68

  box_banner "shest ${SHEST_VERSION}" "Shell test runner"

  section_open "Usage" "$C_CYAN"
  box_row "" "shest [options] [path...]" "$C_CYAN"
  box_row "$C_DIM" "With no path, every *.test.sh under the current directory runs." "$C_CYAN"
  section_close

  section_open "Options" "$C_CYAN"
  help_row "-p, --path <glob|dir>..." "Test files by glob or directory"
  help_row "-f, --file <file>..." "Run the given test file(s)"
  help_row "-t, --filter <regex>" "Only tests whose name matches"
  help_row "    --coverage" "Report line coverage"
  help_row "    --coverage-threshold <n>" "Fail under n% (implies coverage)"
  help_row "    --bail" "Stop after the first failing file"
  help_row "    --timing" "Show the time of each test"
  help_row "    --reporter <name>" "default, tap or junit"
  help_row "    --output-file <file>" "Write the report to a file"
  help_row "    --config <file>" "Config file (default: shest.config.sh)"
  help_row "-v, --version" "Show the version"
  help_row "-h, --help" "Show this help"
  section_close

  section_open "Decorators" "$C_CYAN"
  help_row "# @test <name>" "Declare a test"
  help_row "# @test.skip <name>" "Skip the test"
  help_row "# @test.only <name>" "Run only the .only tests"
  section_close

  section_open "Examples" "$C_CYAN"
  box_row "$C_GREEN" "shest --file sum.test.sh" "$C_CYAN"
  box_row "$C_GREEN" "shest --path 'tests/**/*.test.sh'" "$C_CYAN"
  box_row "$C_GREEN" "shest -t greater --coverage" "$C_CYAN"
  box_row "$C_DIM" "Quote globs so shest expands them; ** matches any depth." "$C_CYAN"
  section_close
}

# Expand one path argument (file, directory or glob) to test files, one per line.
resolve_pattern() {
  local pattern="$1"
  local match
  local IFS=$'\n'

  if [[ -d $pattern ]]; then
    find "$pattern" -type f -name "$TEST_FILE_NAME_PATTERN" | sort
    return
  fi

  # "**" recursion is done with find so it behaves the same on bash 3.2 (macOS).
  if [[ $pattern == *'**'* ]]; then
    local prefix="${pattern%%\*\**}"
    prefix="${prefix%/}"
    find "${prefix:-.}" -type f \( -path "${pattern//\*\*/*}" -o -path "${pattern//\*\*\//}" \) | sort
    return
  fi

  shopt -s nullglob
  # shellcheck disable=SC2206
  for match in $pattern; do
    if [[ -f $match ]]; then
      echo "$match"
    fi
  done
}

run_files() {
  local test_file
  local total_files=0 failed_files=0 skipped_files=0
  local passed=0 failed=0 skipped=0
  local file_passed file_failed file_skipped
  local results_file
  results_file="$(mktemp)"
  local started_at
  started_at="$(now)"
  local coverage_file=''
  if [[ $COVERAGE == true ]]; then
    coverage_file="$(mktemp)"
  fi

  local events_file=''
  local quiet=false
  if [[ $REPORTER != default ]]; then
    events_file="$(mktemp)"
    if [[ -z $OUTPUT_FILE ]]; then
      quiet=true
    fi
  fi

  # With a machine-readable reporter on stdout, the human output is discarded.
  if [[ $quiet == true ]]; then
    exec 3>&1 1>/dev/null
  fi

  for test_file in "$@"; do
    total_files=$((total_files + 1))
    rule "$test_file"

    if ! SHEST_TIMING="$TIMING" SHEST_EVENTS_FILE="$events_file" SHEST_COVERAGE_FILE="$coverage_file" SHEST_RESULTS_FILE="$results_file" bash "$SHEST_SELF" --run-file "$test_file" --filter "$NAME_FILTER"; then
      failed_files=$((failed_files + 1))
      if [[ $BAIL == true ]]; then
        skipped_files=$(($# - total_files))
        echo
        break
      fi
    fi
    echo
  done

  while read -r file_passed file_failed file_skipped; do
    passed=$((passed + file_passed))
    failed=$((failed + file_failed))
    skipped=$((skipped + file_skipped))
  done <"$results_file"
  rm -f "$results_file"

  local coverage_status="$EXIT_SUCCESS"
  if [[ -n $coverage_file ]]; then
    report_coverage "$coverage_file" || coverage_status="$EXIT_FAILURE"
    rm -f "$coverage_file"
    echo
  fi

  rule
  echo "${C_BOLD}Test Files:${C_RESET}  $(format_counts "$total_files" "$((total_files - failed_files))" "$failed_files" 0)"
  print_summary "$((passed + failed + skipped))" "$passed" "$failed" "$skipped"
  echo "${C_BOLD}Time:${C_RESET}        ${C_YELLOW}$(elapsed_since "$started_at")s${C_RESET}"
  if [[ $skipped_files -gt 0 ]]; then
    echo
    echo "${C_YELLOW}Bailed after the first failing file: ${skipped_files} file(s) not run${C_RESET}"
  fi

  if [[ $quiet == true ]]; then
    exec 1>&3 3>&-
  fi

  if [[ -n $events_file ]]; then
    if [[ -n $OUTPUT_FILE ]]; then
      emit_report "$events_file" >"$OUTPUT_FILE"
    else
      emit_report "$events_file"
    fi
    rm -f "$events_file"
  fi

  [[ $failed_files -eq 0 && $coverage_status -eq $EXIT_SUCCESS ]]
}

main() {
  local patterns=()
  local run_file=''
  local files=()
  local pattern
  local test_file
  local config=''
  local arg
  local is_child=false
  local previous=''

  # Config comes first so command-line options override it.
  for arg in "$@"; do
    if [[ $previous == --config ]]; then
      config="$arg"
    elif [[ $arg == --run-file ]]; then
      is_child=true
    fi
    previous="$arg"
  done
  if [[ -z $config && -f shest.config.sh ]]; then
    config='shest.config.sh'
  fi
  if [[ -n $config && $is_child == false ]]; then
    load_config "$config" || return "$EXIT_FAILURE"
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        shift 2 || break
        ;;
      -h | --help)
        usage
        return "$EXIT_SUCCESS"
        ;;
      -v | --version)
        echo "shest ${SHEST_VERSION}"
        return "$EXIT_SUCCESS"
        ;;
      -t | --filter)
        NAME_FILTER="${2:-}"
        shift 2 || break
        ;;
      --coverage)
        COVERAGE=true
        shift
        ;;
      --bail)
        BAIL=true
        shift
        ;;
      --timing)
        TIMING=true
        shift
        ;;
      --reporter)
        REPORTER="${2:-}"
        case "$REPORTER" in
          default | tap | junit) ;;
          *)
            echo "shest: unknown reporter: ${REPORTER} (use default, tap or junit)" >&2
            return "$EXIT_FAILURE"
            ;;
        esac
        shift 2
        ;;
      --output-file)
        OUTPUT_FILE="${2:-}"
        shift 2 || break
        ;;
      --coverage-threshold)
        COVERAGE=true
        COVERAGE_THRESHOLD="${2:-}"
        shift 2 || break
        ;;
      --run-file)
        run_file="$2"
        shift 2
        ;;
      -p | --path | -f | --file)
        shift
        while [[ $# -gt 0 && $1 != -* ]]; do
          patterns+=("$1")
          shift
        done
        ;;
      -*)
        echo "shest: unknown option: $1" >&2
        usage >&2
        return "$EXIT_FAILURE"
        ;;
      *)
        patterns+=("$1")
        shift
        ;;
    esac
  done

  if [[ -n $run_file ]]; then
    run_tests "$run_file"
    return
  fi

  if [[ ${#patterns[@]} -eq 0 && ${#TEST_MATCH[@]} -gt 0 ]]; then
    patterns=("${TEST_MATCH[@]}")
  fi
  if [[ ${#patterns[@]} -eq 0 ]]; then
    patterns=("$DEFAULT_TEST_PATH")
  fi

  for pattern in "${patterns[@]}"; do
    while IFS= read -r test_file; do
      if [[ -n $test_file ]] && ! is_test_ignored "$test_file"; then
        files+=("$test_file")
      fi
    done < <(resolve_pattern "$pattern")
  done

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "shest: no test files found for: ${patterns[*]}" >&2
    return "$EXIT_FAILURE"
  fi

  run_files "${files[@]}"
}

main "$@"
